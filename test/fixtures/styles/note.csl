<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0">
  <info>
    <title>Feuillets CSL Test - Note</title>
    <id>feuillets-csl-test-note</id>
    <updated>2026-10-01T00:00:00Z</updated>
  </info>
  <macro name="author">
    <names variable="author">
      <name and="text" delimiter=", " initialize-with=". "/>
      <substitute>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>
  <citation>
    <layout delimiter="; " suffix=".">
      <group delimiter=", ">
        <text macro="author"/>
        <text variable="title"/>
        <choose>
          <if position="subsequent">
            <text variable="first-reference-note-number" prefix="note "/>
          </if>
        </choose>
      </group>
    </layout>
  </citation>
  <bibliography hanging-indent="true" entry-spacing="1" line-spacing="1">
    <layout>
      <group delimiter=". " suffix=".">
        <text macro="author"/>
        <text variable="title"/>
      </group>
    </layout>
  </bibliography>
</style>
