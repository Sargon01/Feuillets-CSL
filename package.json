{
  "name": "feuillets-csl",
  "version": "0.1.3",
  "description": "Adds native CSL citation processing to the Feuillets writing studio. Requires Feuillets.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:obsidian": "eslint --max-warnings 0 --config obsidian-review.config.mjs main.ts src",
    "audit:network": "node scripts/audit-network.mjs",
    "probe:engine": "node scripts/build-engine-probe.mjs",
    "benchmark:engine": "node scripts/benchmark-engine.mjs",
    "test": "node --import ./test/setup.mjs --test test/*.test.ts"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "csl",
    "citations",
    "feuillets"
  ],
  "author": "Halim Yalcin",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@typescript-eslint/parser": "^8.71.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.20.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@retorquere/bibtex-parser": "11.0.0",
    "citeproc-ts": "0.2.5"
  }
}
